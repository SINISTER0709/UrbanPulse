# ==============================================================================
# UrbanPulse AI - Environment Configuration Template
# ==============================================================================

# Core Application Settings
PROJECT_NAME="UrbanPulse AI Platform"
API_V1_STR="/api"
ENVIRONMENT="development"

# Database Configuration:
# Option A: Local SQLite development database (no external DB needed)
DATABASE_URL="sqlite:///./urbanpulse_dev.db"

# Option B: PostgreSQL + PostGIS (Production / Docker)
# DATABASE_URL="postgresql://urbanpulse:urbanpulse_secret@localhost:5433/urbanpulse_db"

# JWT Security Settings
JWT_SECRET="replace_with_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage & Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# AI Services
AI_SERVICE_ENABLED=true
LLM_PROVIDER="groq" # or "ollama" / "openrouter"
GROQ_API_KEY="your_groq_api_key_here"
