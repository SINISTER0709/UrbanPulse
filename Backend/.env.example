# UrbanPulse Backend Environment Configuration
# Day-0 Core Settings

PROJECT_NAME="UrbanPulse AI Platform"
API_V1_STR="/api"
ENVIRONMENT="development"

# PostgreSQL + PostGIS Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://urbanpulse:urbanpulse_secret@localhost:5432/urbanpulse_db"

# JWT Security Settings
JWT_SECRET="urbanpulse_super_secret_jwt_key_change_in_production_9876543210_token"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage & Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Fault-tolerant AI Worker (Async stub for Stage E1)
AI_SERVICE_ENABLED=false
